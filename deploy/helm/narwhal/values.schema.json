{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Narwhal fleet",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "narwhal": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$",
          "description": "Narwhal image by registry digest"
        },
        "haproxy": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$",
          "description": "HAProxy image by registry digest"
        },
        "fabric": {
          "type": "string",
          "pattern": "^(|[^\\s@]+@sha256:[0-9a-f]{64})$",
          "description": "Image with ib_write_bw, by registry digest; required with fabric gates"
        }
      },
      "required": [
        "narwhal",
        "haproxy"
      ]
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "narwhal.engine-set"
        },
        "schemaVersion": {
          "const": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$",
          "description": "Engine image by registry digest"
        },
        "gpuResource": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?/[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$",
          "description": "GPU device plugin resource name"
        },
        "gpus": {
          "type": "integer",
          "minimum": 1
        },
        "rdmaResource": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?/[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$",
          "description": "RDMA device plugin resource name"
        },
        "modelVolume": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1
        },
        "stateClaim": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "description": "State PersistentVolumeClaim name"
        },
        "serviceName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "Engines' headless Service name"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "Namespace the engine URLs name"
        },
        "sidecarImage": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$",
          "description": "Attestation sidecar image"
        },
        "configMaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serviceAccount": {
              "type": "object"
            },
            "role": {
              "type": "object"
            },
            "roleBinding": {
              "type": "object"
            }
          },
          "required": [
            "serviceAccount",
            "role",
            "roleBinding"
          ]
        },
        "podTemplate": {
          "type": "object",
          "required": [
            "initContainers",
            "containers",
            "volumes"
          ]
        }
      },
      "required": [
        "schema",
        "schemaVersion",
        "count",
        "image",
        "gpuResource",
        "gpus",
        "rdmaResource",
        "modelVolume",
        "stateClaim",
        "serviceName",
        "namespace",
        "sidecarImage",
        "configMaps",
        "access",
        "podTemplate"
      ],
      "description": "The engines, as chart_values derives them from their launch directories"
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageClassName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "description": "StorageClass of the state volume"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?)?$",
          "description": "Requested size of the state volume, such as 10Gi"
        }
      },
      "required": [
        "storageClassName",
        "size"
      ]
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageClassName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "description": "StorageClass of the lease volume"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?)?$",
          "description": "Requested size of the lease volume, such as 10Gi"
        }
      },
      "required": [
        "storageClassName",
        "size"
      ]
    },
    "routers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fleet": {
          "type": "string",
          "pattern": "^[^/].*\\.json$",
          "description": "Fleet file path on the state volume"
        },
        "storageClassName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "description": "StorageClass of each router's own volume"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?)?$",
          "description": "Size of each router's own volume"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "fleet",
        "storageClassName",
        "size"
      ]
    },
    "haproxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "clusterDomain": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "description": "The cluster's DNS domain"
        }
      },
      "required": [
        "replicas",
        "clusterDomain"
      ]
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engineApiKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "env": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "description": "Variable the fleet file names"
            },
            "secretName": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
              "description": "Secret that holds the key"
            },
            "key": {
              "type": "string",
              "pattern": "^[-._A-Za-z0-9]+$",
              "description": "Key in the Secret"
            }
          },
          "required": [
            "env",
            "secretName",
            "key"
          ]
        }
      },
      "required": []
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
            "description": "Job name"
          },
          "kind": {
            "enum": [
              "discovery",
              "engine-check",
              "fabric-server",
              "fabric-client",
              "finalize-fleet",
              "profile",
              "calibrate",
              "preflight"
            ]
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "deadlineSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "node": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
            "description": "Node the Job runs on"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            }
          },
          "resources": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?)?$"
            }
          }
        },
        "required": [
          "name",
          "kind",
          "command",
          "deadlineSeconds"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "discovery",
                    "fabric-server",
                    "fabric-client"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "node"
              ]
            }
          }
        ]
      }
    }
  },
  "required": [
    "images",
    "engines",
    "state",
    "lease",
    "routers"
  ]
}
