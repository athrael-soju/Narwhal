{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Narwhal fleet",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "images": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "narwhal": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$",
          "description": "Narwhal image by registry digest"
        },
        "haproxy": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$",
          "description": "HAProxy image by registry digest"
        },
        "fabric": {
          "type": "string",
          "pattern": "^(|[^\\s@]+@sha256:[0-9a-f]{64})$",
          "description": "Image with ib_write_bw, by registry digest; required with fabric gates"
        }
      },
      "required": [
        "narwhal",
        "haproxy"
      ]
    },
    "engines": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "schema": {
          "const": "narwhal.engine-set"
        },
        "schemaVersion": {
          "const": 1
        },
        "count": {
          "type": "integer",
          "minimum": 1
        },
        "image": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$",
          "description": "Engine image by registry digest"
        },
        "gpuResource": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?/[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$",
          "description": "GPU device plugin resource name"
        },
        "gpus": {
          "type": "integer",
          "minimum": 1
        },
        "rdmaResource": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9.]*[a-z0-9])?/[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$",
          "description": "RDMA device plugin resource name"
        },
        "modelVolume": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1
        },
        "stateClaim": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "description": "State PersistentVolumeClaim name"
        },
        "serviceName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "Engines' headless Service name"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "Namespace the engine URLs name"
        },
        "sidecarImage": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$",
          "description": "Attestation sidecar image"
        },
        "configMaps": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object"
          }
        },
        "access": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "serviceAccount": {
              "type": "object"
            },
            "role": {
              "type": "object"
            },
            "roleBinding": {
              "type": "object"
            }
          },
          "required": [
            "serviceAccount",
            "role",
            "roleBinding"
          ]
        },
        "podTemplate": {
          "type": "object",
          "required": [
            "initContainers",
            "containers",
            "volumes"
          ]
        }
      },
      "description": "The attested engines, as chart_values derives them from their launch directories; leave empty with directEngines",
      "if": {
        "minProperties": 1
      },
      "then": {
        "required": [
          "schema",
          "schemaVersion",
          "count",
          "image",
          "gpuResource",
          "gpus",
          "rdmaResource",
          "modelVolume",
          "stateClaim",
          "serviceName",
          "namespace",
          "sidecarImage",
          "configMaps",
          "access",
          "podTemplate"
        ]
      }
    },
    "directEngines": {
      "type": "object",
      "additionalProperties": false,
      "description": "Engines that start directly from their image, with no launch plan or attestation, as direct_values derives them; leave empty with engines",
      "properties": {
        "schema": {
          "const": "narwhal.direct-engine-set"
        },
        "schemaVersion": {
          "const": 1
        },
        "backend": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]*$",
          "description": "Backend whose direct start rendered the command"
        },
        "count": {
          "type": "integer",
          "minimum": 2,
          "description": "Engines in the fleet; a disaggregated fleet needs a prefill and a decode engine"
        },
        "image": {
          "type": "string",
          "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$",
          "description": "Engine image by registry digest"
        },
        "command": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string"
          },
          "description": "The engine command the backend's direct start renders"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
              },
              "value": {
                "type": "string"
              }
            },
            "required": [
              "name",
              "value"
            ]
          },
          "description": "Variables the engine process needs beyond the image's environment"
        },
        "port": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65535,
          "description": "Port each engine listens on in its pod"
        },
        "resources": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "requests": {
              "type": "object",
              "propertyNames": {
                "pattern": "^(cpu|memory)$"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            },
            "limits": {
              "type": "object",
              "propertyNames": {
                "pattern": "^(cpu|memory)$"
              },
              "additionalProperties": {
                "type": [
                  "string",
                  "integer"
                ]
              }
            }
          },
          "required": [
            "requests",
            "limits"
          ],
          "description": "Each engine's CPU and memory; the command's thread count follows the CPU limit"
        },
        "modelVolume": {
          "type": "object",
          "minProperties": 1,
          "maxProperties": 1
        },
        "modelMount": {
          "type": "string",
          "pattern": "^/[^\\s]*$",
          "description": "Where each engine pod mounts the model volume"
        },
        "sharedMount": {
          "type": "string",
          "pattern": "^/[^\\s]*$",
          "description": "Where each engine pod mounts the directory every engine of the fleet shares"
        },
        "shared": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "storageClassName": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
              "description": "StorageClass of the shared claim"
            },
            "size": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?)?$",
              "description": "Requested size of the shared claim"
            }
          },
          "required": [
            "storageClassName",
            "size"
          ],
          "description": "The ReadWriteMany claim every engine shares, for the backend's KV handoff files"
        },
        "stateClaim": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "description": "State PersistentVolumeClaim name"
        },
        "serviceName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "Engines' headless Service name"
        },
        "namespace": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
          "description": "Namespace the engine URLs name"
        }
      },
      "if": {
        "minProperties": 1
      },
      "then": {
        "required": [
          "schema",
          "schemaVersion",
          "backend",
          "count",
          "image",
          "command",
          "env",
          "port",
          "resources",
          "modelVolume",
          "modelMount",
          "sharedMount",
          "shared",
          "stateClaim",
          "serviceName",
          "namespace"
        ]
      }
    },
    "state": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageClassName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "description": "StorageClass of the state volume"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?)?$",
          "description": "Requested size of the state volume, such as 10Gi"
        }
      },
      "required": [
        "storageClassName",
        "size"
      ]
    },
    "lease": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "storageClassName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "description": "StorageClass of the lease volume"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?)?$",
          "description": "Requested size of the lease volume, such as 10Gi"
        }
      },
      "required": [
        "storageClassName",
        "size"
      ]
    },
    "routers": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fleet": {
          "type": "string",
          "pattern": "^([A-Za-z0-9_-][A-Za-z0-9._-]*/)*[A-Za-z0-9_-][A-Za-z0-9._-]*\\.json$",
          "description": "Fleet file path on the state volume"
        },
        "storageClassName": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "description": "StorageClass of each router's own volume"
        },
        "size": {
          "type": "string",
          "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?)?$",
          "description": "Size of each router's own volume"
        },
        "args": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "fleet",
        "storageClassName",
        "size"
      ]
    },
    "haproxy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "replicas": {
          "type": "integer",
          "minimum": 1
        },
        "clusterDomain": {
          "type": "string",
          "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
          "description": "The cluster's DNS domain"
        }
      },
      "required": [
        "replicas",
        "clusterDomain"
      ]
    },
    "credentials": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "engineApiKey": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "env": {
              "type": "string",
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$",
              "description": "Variable the fleet file names"
            },
            "secretName": {
              "type": "string",
              "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
              "description": "Secret that holds the key"
            },
            "key": {
              "type": "string",
              "pattern": "^[-._A-Za-z0-9]+$",
              "description": "Key in the Secret"
            }
          },
          "required": [
            "env",
            "secretName",
            "key"
          ]
        }
      },
      "required": []
    },
    "gates": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "name": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
            "description": "Job name"
          },
          "kind": {
            "enum": [
              "discovery",
              "engine-check",
              "fabric-server",
              "fabric-client",
              "finalize-fleet",
              "profile",
              "calibrate",
              "preflight"
            ]
          },
          "command": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string"
            }
          },
          "deadlineSeconds": {
            "type": "integer",
            "minimum": 1
          },
          "node": {
            "type": "string",
            "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
            "description": "Node the Job runs on"
          },
          "env": {
            "type": "object",
            "additionalProperties": {
              "type": "string"
            },
            "propertyNames": {
              "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
            }
          },
          "resources": {
            "type": "object",
            "additionalProperties": {
              "type": "string",
              "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?)?$"
            },
            "propertyNames": {
              "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?/)?[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$"
            }
          }
        },
        "required": [
          "name",
          "kind",
          "command",
          "deadlineSeconds"
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "enum": [
                    "discovery",
                    "fabric-server",
                    "fabric-client"
                  ]
                }
              }
            },
            "then": {
              "required": [
                "node"
              ]
            }
          }
        ]
      }
    },
    "monitoring": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "prometheus": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "string",
              "pattern": "^(|[^\\s@]+@sha256:[0-9a-f]{64})$",
              "description": "Prometheus image by registry digest"
            },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "storageClassName": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
                  "description": "StorageClass of the data claim"
                },
                "size": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?)?$",
                  "description": "Requested size of the data claim, such as 20Gi"
                }
              },
              "required": [
                "storageClassName",
                "size"
              ]
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "limits": {
                  "type": "object",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?|m)?$"
                      },
                      {
                        "type": "number",
                        "minimum": 0
                      }
                    ]
                  },
                  "propertyNames": {
                    "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?/)?[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$"
                  }
                },
                "requests": {
                  "type": "object",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?|m)?$"
                      },
                      {
                        "type": "number",
                        "minimum": 0
                      }
                    ]
                  },
                  "propertyNames": {
                    "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?/)?[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$"
                  }
                }
              },
              "description": "Container resource requests and limits"
            }
          }
        },
        "grafana": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "image": {
              "type": "string",
              "pattern": "^(|[^\\s@]+@sha256:[0-9a-f]{64})$",
              "description": "Grafana image by registry digest"
            },
            "dashboard": {
              "type": "string",
              "description": "The dashboard python -m tools.observability.chart_dashboard renders"
            },
            "admin": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "secretName": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$"
                },
                "userKey": {
                  "type": "string",
                  "pattern": "^[-._a-zA-Z0-9]+$"
                },
                "passwordKey": {
                  "type": "string",
                  "pattern": "^[-._a-zA-Z0-9]+$"
                }
              },
              "description": "The Secret that holds the Grafana admin login"
            },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "storageClassName": {
                  "type": "string",
                  "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]*[a-z0-9])?)*$",
                  "description": "StorageClass of the data claim"
                },
                "size": {
                  "type": "string",
                  "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?)?$",
                  "description": "Requested size of the data claim, such as 20Gi"
                }
              },
              "required": [
                "storageClassName",
                "size"
              ]
            },
            "resources": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "limits": {
                  "type": "object",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?|m)?$"
                      },
                      {
                        "type": "number",
                        "minimum": 0
                      }
                    ]
                  },
                  "propertyNames": {
                    "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?/)?[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$"
                  }
                },
                "requests": {
                  "type": "object",
                  "additionalProperties": {
                    "anyOf": [
                      {
                        "type": "string",
                        "pattern": "^[0-9]+(\\.[0-9]+)?([KMGTPE]i?|m)?$"
                      },
                      {
                        "type": "number",
                        "minimum": 0
                      }
                    ]
                  },
                  "propertyNames": {
                    "pattern": "^([a-z0-9]([-a-z0-9.]*[a-z0-9])?/)?[A-Za-z0-9]([-A-Za-z0-9_.]*[A-Za-z0-9])?$"
                  }
                }
              },
              "description": "Container resource requests and limits"
            }
          }
        }
      },
      "required": [
        "enabled"
      ],
      "if": {
        "properties": {
          "enabled": {
            "const": true
          }
        }
      },
      "then": {
        "required": [
          "prometheus",
          "grafana"
        ],
        "properties": {
          "prometheus": {
            "required": [
              "image"
            ],
            "properties": {
              "image": {
                "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$"
              }
            }
          },
          "grafana": {
            "required": [
              "image",
              "dashboard",
              "admin"
            ],
            "properties": {
              "image": {
                "pattern": "^[^\\s@]+@sha256:[0-9a-f]{64}$"
              },
              "dashboard": {
                "minLength": 1
              },
              "admin": {
                "required": [
                  "secretName",
                  "userKey",
                  "passwordKey"
                ]
              }
            }
          }
        }
      }
    }
  },
  "required": [
    "images",
    "engines",
    "state",
    "lease",
    "routers"
  ],
  "if": {
    "properties": {
      "directEngines": {
        "minProperties": 1
      }
    },
    "required": [
      "directEngines"
    ]
  },
  "then": {
    "properties": {
      "engines": {
        "maxProperties": 0,
        "description": "Set engines or directEngines, not both"
      },
      "gates": {
        "maxItems": 0,
        "description": "Gate Jobs check attested engines; directEngines take none"
      }
    }
  },
  "else": {
    "properties": {
      "engines": {
        "minProperties": 1,
        "description": "The engines, from chart_values, or directEngines"
      }
    }
  }
}
