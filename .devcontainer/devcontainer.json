{
  "name": "Narwhal",
  "image": "mcr.microsoft.com/devcontainers/python:3.12-bookworm@sha256:810cf704128b9d4fa64dc14576335655340871e7a2c046bb08f7952549cb92c5",
  "hostRequirements": {
    "cpus": 2,
    "memory": "8gb"
  },
  "postCreateCommand": "make setup chart-tools",
  "remoteEnv": {
    "PATH": "${containerWorkspaceFolder}/.venv/bin:${containerEnv:PATH}"
  },
  "forwardPorts": [18000],
  "portsAttributes": {
    "18000": {
      "label": "Narwhal dev router",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "codespaces": {
      "openFiles": ["docs/dev/Quick-Start.md"]
    },
    "vscode": {
      "extensions": ["ms-python.python", "charliermarsh.ruff"]
    }
  }
}
