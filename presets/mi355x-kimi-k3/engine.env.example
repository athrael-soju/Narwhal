# Engine environment for the MI355X / Kimi-K3 pair.
# Copy to engine.env beside engine_serve.sh and fill in your paths.

# --- model --------------------------------------------------------------
MODEL_PATH=/models/Kimi-K3
SERVED_MODEL_NAME=moonshotai/Kimi-K3
ENGINE_ARGS="
  --tensor-parallel-size 8
  --max-model-len 1048576
  --block-size 128
  --reasoning-parser kimi_k3
  --tool-call-parser kimi_k3
  --enable-auto-tool-choice
  --trust-remote-code
  --no-disable-hybrid-kv-cache-manager
  --max-num-batched-tokens 16384
  --language-model-only
"

# --- environment --------------------------------------------------------
# The MXFP4 MoE path on ROCm requires AITER (missing env => "No MXFP4 MoE
# backend supports the deployment configuration" at worker init). The DS
# conv-state layout is required by NIXL's mamba transfer for this hybrid
# model; on the validated image it is incompatible with speculative
# decoding, which stays off.
export VLLM_ROCM_USE_AITER=1
export VLLM_SSM_CONV_STATE_LAYOUT=DS
export UCX_MODULE_DIR=/usr/local/lib/python3.12/dist-packages/nixl_rocm.libs/ucx
export UCX_TCP_PORT_RANGE=6300-6500

# --- container (scripts/container_recreate.sh) --------------------------
# Engine image, GPU/RDMA device pass-through and host binds for the
# node-local sleep-infinity container. The device set below is ROCm's; a
# CUDA fleet uses "--gpus all --device /dev/infiniband". Binds are
# src:dst[:ro], whitespace-separated.
CONTAINER_IMAGE=rocm/vllm-dev@sha256:5aa7e626ff73672f5ca7aae46754570488c23d33ca1ac90756a1d2d1a3fe099b
CONTAINER_DEVICE_ARGS="--device /dev/kfd --device /dev/dri --device /dev/infiniband"
CONTAINER_BINDS="
  /models/Kimi-K3:/models/Kimi-K3:ro
"

# --- paths --------------------------------------------------------------
# Where engine logs land (default: ./runs relative to where the launcher runs).
LOG_DIR=./runs
