{
  "_": "Topology walk, aggregated cell. The static cell with every engine both-phasing its own requests locally. No KV ever crosses the fabric.",
  "model": "moonshotai/Kimi-K3",
  "engines": [
    {
      "iid": "n1",
      "url": "http://<node-1-fabric-address>:8002",
      "role": "decode",
      "pin": true
    },
    {
      "iid": "n2",
      "url": "http://<node-2-fabric-address>:8002",
      "role": "decode",
      "pin": true
    },
    {
      "iid": "n3",
      "url": "http://<node-3-fabric-address>:8002",
      "role": "decode",
      "pin": true
    },
    {
      "iid": "n4",
      "url": "http://<node-4-fabric-address>:8002",
      "role": "decode",
      "pin": true
    },
    {
      "iid": "n5",
      "url": "http://<node-5-fabric-address>:8002",
      "role": "decode",
      "pin": true
    },
    {
      "iid": "n6",
      "url": "http://<node-6-fabric-address>:8002",
      "role": "decode",
      "pin": true
    }
  ],
  "slo": {
    "ttft_s": 3.0,
    "tpot_s": 0.06
  },
  "thresholds": {
    "expand": 1000000000.0,
    "shrink": 0.5,
    "cooldown_s": 1000000000.0,
    "sustained_intervals": 1000000000
  },
  "controller": "reactive",
  "monitor_interval_s": 1.0,
  "tokenize": true,
  "chars_per_token": 3.8,
  "first_token_timeout_s": 30.0,
  "decode_read_timeout_s": 300.0,
  "prefill_timeout_s": 120.0,
  "request_timeout_s": 600.0,
  "profiles_path": "runs/local/profiles.json",
  "connector": "nixl",
  "dialect": "vllm"
}
