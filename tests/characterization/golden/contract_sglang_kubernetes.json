      "prefill",
      "--disaggregation-transfer-backend",
      "mooncake",
      "--enable-pd-role-switch",
      "--disaggregation-decode-enable-radix-cache",
      "--context-length",
      "4096",
      "--kv-events-config",
      "{\"publisher\": \"zmq\", \"endpoint\": \"ipc:///narwhal-kv-events/events.sock\", \"replay_endpoint\": \"ipc:///narwhal-kv-events/replay.sock\"}"
    ]
