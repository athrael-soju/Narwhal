# Copy this file to .env, restrict it to mode 0600, and fill every value.
# Load it from the checkout root with shell tracing disabled:
#   set +x
#   set -a
#   . ./.env
#   set +a

# The Narwhal release wheel that every host installs, the hash-pinned lock of its
# dependencies and their SHA-256 values, all from the private record.
NARWHAL_WHEEL=''
NARWHAL_WHEEL_SHA256=''
NARWHAL_REQUIREMENTS=''
NARWHAL_REQUIREMENTS_SHA256=''

# Known-hosts file with the verified key of every SSH destination below. Every
# narwhal deploy command checks host keys against it and never writes to it.
NARWHAL_SSH_KNOWN_HOSTS='config/ssh.known_hosts'
# Set only to reach every host through one jump host, whose key the known-hosts file holds.
# NARWHAL_SSH_JUMP=''

# Immutable engine image, served model, host paths, fabric interface and ports.
NARWHAL_ENGINE_IMAGE=''
NARWHAL_ENGINE_MODEL_NAME=''
# Absolute checkpoint path on each engine host, and the checkpoint's model_tree_sha256.
NARWHAL_MODEL_DIR=''
NARWHAL_MODEL_TREE_SHA256=''
# For a GGUF model on vLLM, the absolute path of the .gguf file in NARWHAL_MODEL_DIR,
# and the plugin digests that the deploy/vllm-gguf image build prints.
# NARWHAL_MODEL_PATH=''
# NARWHAL_GGUF_PLUGIN_PYTHON_SHA256=''
# NARWHAL_GGUF_PLUGIN_EXTENSION_SHA256=''
# For a multimodal GGUF model, false keeps multimodal input on every engine.
# NARWHAL_LANGUAGE_MODEL_ONLY=''
NARWHAL_RUN_DIR=''
NARWHAL_FABRIC_INTERFACE=''
NARWHAL_ENGINE_PORT=''
NARWHAL_ATTEST_PORT=''
NARWHAL_KV_SIDE_CHANNEL_PORT=''
NARWHAL_UCX_TCP_PORT_RANGE=''
# For an SGLang fleet, set NARWHAL_ENGINE_BACKEND=sglang.

# Fabric qualification: the KV workload each directed host edge must carry, and the TCP port
# the test server listens on. The firewall between fabric addresses must allow that port.
NARWHAL_FABRIC_PROMPT_TOKENS=''
NARWHAL_FABRIC_HANDOFFS_PER_S=''
NARWHAL_FABRIC_BURST=''
NARWHAL_FABRIC_TRANSFER_BUDGET_S=''
NARWHAL_FABRIC_HEADROOM=''
NARWHAL_FABRIC_TEST_PORT=''
# For ucx_rdma, the GID index of each engine's HCA port and the RoCE mode: v2, v1, or
# infiniband. NARWHAL_NODE_<n>_RDMA_GID_INDEX and _RDMA_ROCE_MODE set one engine's values.
# NARWHAL_RDMA_GID_INDEX=''
# NARWHAL_RDMA_ROCE_MODE=''

# narwhal deploy run: the SLO targets and router overhead in seconds, the margin the
# first-token deadline keeps above its calibrated candidate, the profiling sweep, the
# first-token calibration, and the http://HOST:PORT the router binds.
NARWHAL_TTFT_S=''
NARWHAL_TPOT_S=''
NARWHAL_ROUTER_OVERHEAD_S='0'
NARWHAL_FIRST_TOKEN_MARGIN_S=''
NARWHAL_PROFILE_PREFILL_LENS=''
NARWHAL_PROFILE_DECODE_INPUT_LENS=''
# NARWHAL_PROFILE_DECODE_CONCURRENCY=''
NARWHAL_PROFILE_WARMUP_REQUESTS=''
NARWHAL_CALIBRATION_INPUT_TOKENS=''
NARWHAL_CALIBRATION_SAMPLES=''
NARWHAL_CALIBRATION_OBSERVATION_TIMEOUT_S=''
NARWHAL_ROUTER_URL=''

# The fleet label of every series the monitoring stack scrapes, and the optional
# Alertmanager that Prometheus sends alerts to.
NARWHAL_FLEET_NAME=''
# NARWHAL_ALERTMANAGER_URL=''

# A router pair: the standby router's host, another host than the primary's, the origins
# the standby and HAProxy bind, the lease file on storage both router hosts mount, and the
# HAProxy image by digest. Leave NARWHAL_STANDBY_ROUTER_SSH unset for one router, with no
# failover. HAProxy runs on the primary router's host unless NARWHAL_LOAD_BALANCER_SSH is set.
# NARWHAL_STANDBY_ROUTER_SSH=''
# NARWHAL_STANDBY_ROUTER_URL=''
# NARWHAL_LOAD_BALANCER_URL=''
# NARWHAL_LEASE_PATH=''
# NARWHAL_HAPROXY_IMAGE=''
# NARWHAL_LOAD_BALANCER_SSH=''

# The router uses the first engine host by default. Set NARWHAL_ROUTER_SSH
# and its password only when the router has a separate management destination.
# SSH destinations accept an alias or user@host; OpenSSH can supply key identity.
# NARWHAL_ROUTER_SSH=''
# NARWHAL_ROUTER_SSH_PASSWORD=''

# Define one numbered block per engine. Discovery requires at least two engines.
NARWHAL_NODE_1_SSH=''
# NARWHAL_NODE_1_SSH_PASSWORD=''

NARWHAL_NODE_2_SSH=''
# NARWHAL_NODE_2_SSH_PASSWORD=''

# Discovery reads the unique global address on NARWHAL_FABRIC_INTERFACE.
# Set NARWHAL_NODE_<n>_IP only when that interface has multiple addresses.
# Discovery derives engine and attestation URLs from that address and the ports.
# Set NARWHAL_NODE_<n>_URL or NARWHAL_NODE_<n>_ATTESTATION_URL only when
# that service uses a different address or port.
# Discovery derives the host inventory, model-config hash,
# GPU allocation, launch records and fleet configuration from these values and
# remote inspection. docs/configuration/04-Deployment-Inputs.md lists every input,
# the optional launch policy overrides included.
