# Copy this file to .env, restrict it to mode 0600, and fill every value.
# Load it from the checkout root with shell tracing disabled:
#   set +x
#   set -a
#   . ./.env
#   set +a

# Full approved commit SHA available in the management checkout.
NARWHAL_DEPLOYMENT_REVISION=''

# Immutable engine image, served model, host paths, fabric interface and ports.
NARWHAL_ENGINE_IMAGE=''
NARWHAL_ENGINE_MODEL_NAME=''
NARWHAL_MODEL_DIR=''
NARWHAL_RUN_DIR=''
NARWHAL_FABRIC_INTERFACE=''
NARWHAL_ENGINE_PORT=''
NARWHAL_ATTEST_PORT=''
NARWHAL_NIXL_SIDE_CHANNEL_PORT=''
NARWHAL_UCX_TCP_PORT_RANGE=''

# Router management access. Destinations accept an SSH alias or user@host.
# Leave the password unset when OpenSSH supplies a key or agent identity.
NARWHAL_ROUTER_SSH=''
# NARWHAL_ROUTER_SSH_PASSWORD=''

# Define one numbered block per engine. Discovery requires at least two engines.
# Reuse the router destination for an engine colocated with the router.
NARWHAL_NODE_1_SSH=''
# NARWHAL_NODE_1_SSH_PASSWORD=''
NARWHAL_NODE_1_IP=''
NARWHAL_NODE_1_URL=''
NARWHAL_NODE_1_ATTESTATION_URL=''

NARWHAL_NODE_2_SSH=''
# NARWHAL_NODE_2_SSH_PASSWORD=''
NARWHAL_NODE_2_IP=''
NARWHAL_NODE_2_URL=''
NARWHAL_NODE_2_ATTESTATION_URL=''

# Discovery derives the host inventory, SSH trust store, model-config hash,
# GPU allocation, launch records and fleet configuration from these values and
# remote inspection. docs/Deploy.md lists optional policy overrides.
