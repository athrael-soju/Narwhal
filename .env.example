# Copy to .env, restrict its permissions, then edit it:
#   install -m 600 .env.example .env
# Load it from the checkout root before running Narwhal:
#   set -a
#   . ./.env
#   set +a
# Git ignores .env.
# Use single quotes around literal credential values.

# The CPU walkthrough needs no credentials. For your own fleet, change to
# config/fleet.json (also ignored by Git) after creating that document.
# CLI commands require --fleet "$NARWHAL_FLEET". `make observe` and Python
# callers of create_app() read this variable directly.
NARWHAL_FLEET=config/fleet.stub.json

# A site-specific, ignored config/fleet.json can reference endpoint values
# directly from the environment:
#   "url": "${NARWHAL_NODE_1_URL}"
#   "attestation_url": "${NARWHAL_NODE_1_ATTESTATION_URL}"
# Include /v1/attestation in each attestation URL. Missing or empty referenced
# variables fail configuration loading. Prometheus engine scrapes require HTTP.
# NARWHAL_NODE_1_URL=''
# NARWHAL_NODE_1_ATTESTATION_URL=''
# NARWHAL_NODE_2_URL=''
# NARWHAL_NODE_2_ATTESTATION_URL=''
# NARWHAL_NODE_3_URL=''
# NARWHAL_NODE_3_ATTESTATION_URL=''
# NARWHAL_NODE_4_URL=''
# NARWHAL_NODE_4_ATTESTATION_URL=''
# NARWHAL_NODE_5_URL=''
# NARWHAL_NODE_5_ATTESTATION_URL=''
# NARWHAL_NODE_6_URL=''
# NARWHAL_NODE_6_ATTESTATION_URL=''

# Optional shared engine Bearer token. Enable it in the fleet JSON with:
#   "engine": {"engine_api_key_env": "NARWHAL_ENGINE_KEY"}
# Match the credential configured on every engine. Public client
# authentication belongs to ingress. An enabled but empty key fails startup.
# NARWHAL_ENGINE_KEY=''

# Optional settings for `make observe`. The router URL is a scrape target;
# configure the router listener separately with --host and --port.
NARWHAL_ROUTER_URL=http://127.0.0.1:8000
NARWHAL_GRAFANA_BIND_ADDRESS=127.0.0.1
NARWHAL_PROMETHEUS_LISTEN_ADDRESS=127.0.0.1:9090
