# Narwhal fleet credentials. `narwhal-fleet` reads this file at the
# repository root. One block per node, named `<PREFIX>_<n>_*`. The prefix
# defaults to NODE; `--prefix` or `NARWHAL_FLEET_PREFIX` selects another
# scheme. `_IP` is the management address. `_FABRIC` is the address the
# engines serve on, when the two differ; a dead management path falls
# back through a healthy peer over the fabric. `_KEY` is an SSH key path,
# and `_PASSWORD` a password (delivered via sshpass, never argv). No
# value from this file belongs in a log or a tracked file.

NODE_1_IP=
NODE_1_USERNAME=
NODE_1_PASSWORD=
NODE_1_KEY=
NODE_1_FABRIC=

NODE_2_IP=
NODE_2_USERNAME=
NODE_2_PASSWORD=
NODE_2_KEY=
NODE_2_FABRIC=
