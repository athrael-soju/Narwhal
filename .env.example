# Copy to .env, restrict its permissions, then edit it:
#   install -m 600 .env.example .env
# Load it from the checkout root before running Narwhal:
#   set -a
#   . ./.env
#   set +a
# Git ignores .env.
# Use single quotes around literal credential values.

# Private management access for docs/Deploy.md.
# Discovery creates the host inventory from NODE_<n>_SSH and ROUTER_SSH values.
NARWHAL_HOSTS=config/hosts.local.json
# Discovery writes GPU allocation, TP size, devices and runtime settings here.
NARWHAL_LAUNCH_CONFIG=config/engine-launch.local.json
NARWHAL_SSH_KNOWN_HOSTS=config/ssh.known_hosts
# Access entries consumed by tools/discover_deployment.py:
# NARWHAL_NODE_1_SSH=''
# NARWHAL_NODE_1_SSH_PASSWORD=''
# NARWHAL_NODE_2_SSH=''
# NARWHAL_NODE_2_SSH_PASSWORD=''
# NARWHAL_ROUTER_SSH=''
# Reuse the same destination value for colocated router and engine roles.
# Destinations accept SSH aliases or user@management-host. Passwords are passed
# through a file descriptor. Omit the password variable for key/agent use.
# Discovery records SSH host keys on first use and rejects changed keys.

# Use the ignored fleet document created by docs/Deploy.md.
# CLI commands require --fleet "$NARWHAL_FLEET". `make observe` and Python
# callers of create_app() read this variable directly.
NARWHAL_FLEET=config/fleet.json

# Load these values on the workstation. Discovery inspects hosts and generates
# configuration; source its derived.env before tools/deploy_hosts.py prepare.
# The preparation command creates all role files described in docs/Deploy.md. Each remote shell
# sources .env.router or .env.engine-<n> from its checkout. Keep the fleet
# inventory in ignored config/fleet.json, with one engine entry per node.
# Site access tooling supplies the management login; engine URLs identify HTTP services, while the site's fabric inventory identifies NIXL addresses.
# Full commit SHA available in the management checkout. The deployment guide
# packages it into a verified source bundle for the remote clones.
# NARWHAL_DEPLOYMENT_REVISION=''
# NARWHAL_ENGINE_IMAGE=''
# NARWHAL_ENGINE_MODEL_NAME=''
# NARWHAL_MODEL_DIR=''
# NARWHAL_RUN_DIR=''
# Optional expected hash; discovery checks it when supplied and records the observed hash.
# NARWHAL_MODEL_CONFIG_SHA256=''
# NARWHAL_FABRIC_INTERFACE=''
# NARWHAL_ENGINE_PORT=''
# NARWHAL_ATTEST_PORT=''
# NARWHAL_NIXL_SIDE_CHANNEL_PORT=''
# NARWHAL_UCX_TCP_PORT_RANGE=''
# Per-node overrides replace shared launch values in the selected engine file:
# NARWHAL_NODE_2_MODEL_DIR=''
# NARWHAL_NODE_2_ENGINE_PORT=''

# Optional discovery policy; node-specific fields override shared values.
# The default allocates all detected GPUs to one engine and uses TP equal to count.
# Multiple engine roles on one host require explicit disjoint GPU_IDS.
# NARWHAL_GPU_IDS='0,1'
# NARWHAL_TENSOR_PARALLEL_SIZE='2'
# NARWHAL_MODEL_DTYPE='bfloat16'
# NARWHAL_BLOCK_SIZE='128'
# JSON arrays/objects use single shell quotes around the entire JSON value.
# NARWHAL_ENGINE_ARGS='["--max-model-len","16384","--max-num-seqs","8","--gpu-memory-utilization","0.9","--enforce-eager"]'
# NARWHAL_ENGINE_ENV='{}'
# TCP uses FABRIC_INTERFACE by default. RDMA requires HCA:port and device mappings.
# NARWHAL_TRANSFER_TRANSPORT='ucx_rdma'
# NARWHAL_TRANSFER_NET_DEVICES='mlx5_0:1'
# NARWHAL_TRANSFER_DEVICES='["/dev/infiniband/rdma_cm","/dev/infiniband/uverbs0"]'
# Candidate latency limits, refined after profiling:
# NARWHAL_TTFT_S='10'
# NARWHAL_TPOT_S='0.125'

# A site-specific, ignored config/fleet.json can reference endpoint values
# directly from the environment. This is one example; add a pair only for
# each engine whose URLs you reference from the fleet document:
#   "url": "${NARWHAL_NODE_1_URL}"
#   "attestation_url": "${NARWHAL_NODE_1_ATTESTATION_URL}"
# Include /v1/attestation in each attestation URL. Missing or empty referenced
# variables fail configuration loading. Prometheus engine scrapes require HTTP.
# NARWHAL_NODE_1_URL=''
# NARWHAL_NODE_1_ATTESTATION_URL=''

# Optional shared engine Bearer token. Enable it in the fleet JSON with:
#   "engine": {"engine_api_key_env": "NARWHAL_ENGINE_KEY"}
# Match the credential configured on every engine. Public client
# authentication belongs to ingress. An enabled but empty key fails startup.
# NARWHAL_ENGINE_KEY=''

# Optional settings for `make observe`. The router URL is a scrape target;
# configure the router listener separately with --host and --port.
NARWHAL_ROUTER_URL=http://127.0.0.1:8000
NARWHAL_GRAFANA_BIND_ADDRESS=127.0.0.1
NARWHAL_PROMETHEUS_LISTEN_ADDRESS=127.0.0.1:9090
